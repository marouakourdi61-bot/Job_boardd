<%- include("../partials/header", { title: offre.titre }) %>

<%- include("../partials/navbar") %>

<div class="container">

   
    <a href="/offres" class="back-link">
        &larr; Retour aux offres
    </a>

    
    <main class="detail-card">

        
        <span class="star-icon">★</span>

        <div class="offer-header-top">

            <span
                class="<%= offre.type_contrat.toLowerCase() === 'stage'
                    ? 'badge-stage'
                    : 'badge-alternance' %>">

                

            </span>

            <span class="date">
                
            </span>

        </div>

        
        <h1 class="offer-title">
            <%= offre.titre %>
        </h1>

        
        <div class="company-info">
            <%= offre.entreprise_nom %> - <%= offre.ville %>
        </div>

        
        <div class="tags">

            <% offre.technologies.forEach((technologie) => { %>

                <span class="tag">
                    <%= technologie.nom %>
                </span>

            <% }) %>

        </div>


        
        <div class="section-title">
            Mission
        </div>

        <div class="section-content">
            <%= offre.description_longue %>
        </div>


        
        <div class="section-title">
            Profil recherché
        </div>

        <div class="section-content">
            <%= offre.profil_recherche %>
        </div>


        
        <div class="section-title">
            Candidature
        </div>

        <div class="section-content">

            <a href="<%= offre.lien_candidature %>" target="_blank">
                Postuler à cette offre
            </a>

        </div>

    </main>

</div>

<%- include("../partials/footer") %>