<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Offres de stage et alternance</title>
</head>

<body>

    <h1>Offres de stage et alternance</h1>

    <p>
        <strong><%= offres.length %></strong> offres disponibles
    </p>

    <% if (offres.length === 0) { %>

        <p>Aucune offre disponible.</p>

    <% } else { %>

        <% offres.forEach(offre => { %>

            <article>
                <h2>
                    <%= offre.titre %>
                </h2>

                <p>
                    <strong>Ville :</strong>
                    <%= offre.ville %>
                </p>

                <p>
                    <strong>Type :</strong>
                    <%= offre.type_contrat %>
                </p>

                <p>
                    <strong>Description :</strong>
                    <%= offre.description_courte %>
                </p>

                <p>
                    <strong>Date :</strong>
                    <%= offre.date_publication %>
                </p>

                <hr>
            </article>

        <% }) %>

    <% } %>

</body>
</html>