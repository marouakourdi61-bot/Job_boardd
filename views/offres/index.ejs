<%- include("../partials/header", { title: "Offres disponibles" }) %>

    <%- include("../partials/navbar") %>

        <div class="container">

            <!-- Titre -->
            <h1>Offres disponibles</h1>

            <p class="subtitle" id="result-count">
                <%= offres.length %> offres trouvées
            </p>


            <!-- Recherche -->
            <form action="/offres" method="GET">

                <div class="filters">

                    <input id="input_search" type="text" name="search" placeholder="Rechercher...">

                    <button type="submit">
                        Rechercher
                    </button>


                    <!-- Filtre ville -->
                    <select id="filter_place" name="ville">
                        <option value="">Toutes les villes</option>

                        <% villes.forEach((villeOption)=> { %>

                            <option value="<%= villeOption.ville %>" <%=ville===villeOption.ville ? "selected" : "" %>>
                                <%= villeOption.ville %>
                            </option>

                            <% }) %>
                    </select>


                    <!-- Filtre technologie -->
                    <select id="filter_tec" name="technologie">

                        <option value="">Toutes les technos</option>

                        <% technologies.forEach((technologieOption)=> { %>

                            <option value="<%= technologieOption.nom %>" <%=technologie===technologieOption.nom
                                ? "selected" : "" %>
                                >
                                <%= technologieOption.nom %>
                            </option>

                            <% }) %>

                    </select>


                    <!-- Filtre contrat -->
                    <select id="filter_contrat" name="typeContrat">
                        <option value="">Tous les contrats</option>

                        <option value="Stage" <%=typeContrat==="Stage" ? "selected" : "" %>
                            >
                            Stage
                        </option>

                        <option value="Alternance" <%=typeContrat==="Alternance" ? "selected" : "" %>
                            >
                            Alternance
                        </option>
                    </select>


                    <!-- Tri par date -->
                    <% if (sort==="desc" ) { %>

                        <input type="hidden" name="sort" value="asc">

                        <button type="submit" class="btn-date">
                            Date ↑
                        </button>

                        <% } else { %>

                            <input type="hidden" name="sort" value="desc">

                            <button type="submit" class="btn-date">
                                Date ↓
                            </button>

                            <% } %>
            </form>

        </div>


        <!-- Liste des offres -->
        <div id="offres-container">

            <% offres.forEach((offre)=> { %>

                <article class="offer-card">

                    <div class="offer-header">

                        <div>

                            <span class="badge-stage">
                                <%= offre.type_contrat %>
                            </span>

                            <span class="date">
                                <%= offre.date_publication %>
                            </span>

                        </div>

                        <span class="star">
                            ☆
                        </span>

                    </div>


                    <h2 class="offer-title">
                        <%= offre.titre %>
                    </h2>


                    <p class="company-info">
                        <%= offre.entreprise_nom %> -
                            <%= offre.ville %>
                    </p>


                    <p class="description">
                        <%= offre.description_courte %>
                    </p>


                    <div class="tags">

                        <% offre.technologies.forEach((technologie)=> { %>

                            <span class="tag">
                                <%= technologie.nom %>
                            </span>

                            <% }) %>

                    </div>


                    <a class="btn-voir" href="/offres/<%= offre.id %>">
                        Voir
                    </a>

                </article>

                <% }) %>

        </div>

        </div>
        <script>
            const filterPlace = document.querySelector("#filter_place");
            const filterTec = document.querySelector("#filter_tec");
            const filterContrat = document.querySelector("#filter_contrat");

            filterPlace.addEventListener("change", () => {
                filterPlace.form.submit();
            });

            filterTec.addEventListener("change", () => {
                filterTec.form.submit();
            });

            filterContrat.addEventListener("change", () => {
                filterContrat.form.submit();
            });
        </script>
        <%- include("../partials/footer") %>