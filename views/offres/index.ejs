<%- include("../partials/header", { title: "Offres disponibles" }) %>

    <%- include("../partials/navbar") %>

        <div class="container">

            <!-- Titre -->
            <h1>Offres disponibles</h1>

            <p class="subtitle" id="result-count">
                <%= offres.length %> offres trouvées
            </p>


            <!-- Recherche -->
            <div class="filters">

                <form action="/offres" method="GET">

                    <input id="input_search" type="text" name="search" placeholder="Rechercher...">

                    <button type="submit">
                        Rechercher
                    </button>


                    <!-- Filtre ville -->
                    <select id="filter_place" name="ville">
                        <option value="">Toutes les villes</option>

                        <% villes.forEach((villeOption)=> { %>

                            <option value="<%= villeOption.ville %>" <%=ville===villeOption.ville ? "selected" : "" %>>
                                <%= villeOption.ville %>
                            </option>

                            <% }) %>
                    </select>


                    <!-- Filtre technologie -->
                    <select id="filter_tec">
                        <option>Toutes les technos</option>
                    </select>


                    <!-- Filtre contrat -->
                    <select id="filter_contrat">
                        <option>Tous les contrats</option>
                        <option>Stage</option>
                        <option>Alternance</option>
                    </select>


                    <!-- Tri par date -->
                    <button class="btn-date">
                        Date ↓
                    </button>

            </div>
            </form>

            <!-- Liste des offres -->
            <div id="offres-container">

                <% offres.forEach((offre)=> { %>

                    <article class="offer-card">

                        <div class="offer-header">

                            <div>

                                <span class="badge-stage">
                                    <%= offre.type_contrat %>
                                </span>

                                <span class="date">
                                    <%= offre.date_publication %>
                                </span>

                            </div>

                            <span class="star">
                                ☆
                            </span>

                        </div>


                        <h2 class="offer-title">
                            <%= offre.titre %>
                        </h2>


                        <p class="company-info">
                            <%= offre.entreprise_nom %> -
                                <%= offre.ville %>
                        </p>


                        <p class="description">
                            <%= offre.description_courte %>
                        </p>


                        <div class="tags">

                            <% offre.technologies.forEach((technologie)=> { %>

                                <span class="tag">
                                    <%= technologie.nom %>
                                </span>

                                <% }) %>

                        </div>


                        <a class="btn-voir" href="/offres/<%= offre.id %>">
                            Voir
                        </a>

                    </article>

                    <% }) %>

            </div>

        </div>
        <script>
            const filterPlace = document.querySelector("#filter_place");

            filterPlace.addEventListener("change", () => {
                filterPlace.form.submit();
            });
        </script>
        <%- include("../partials/footer") %>